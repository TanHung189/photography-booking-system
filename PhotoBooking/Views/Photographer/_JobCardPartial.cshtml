@model PhotoBooking.Models.DonDatLich

<div class="card shadow-sm border-0 mb-4 job-card rounded-4 overflow-hidden @(Model.TrangThai == 0 ? "border-start border-primary border-5 bg-light" : "")">
    <div class="card-body p-4">
        
        @if (Model.TrangThai == 0)
        {
            <div class="alert alert-primary d-flex align-items-center py-2 mb-3 border-0 shadow-sm">
                <i class="fas fa-star me-2 heartbeat-animation text-warning"></i>
                <div class="small">
                    <strong class="text-uppercase">Yêu cầu mới:</strong> Khách hàng <strong>@Model.MaKhachHangNavigation?.HoVaTen</strong> đang đợi bạn xác nhận lịch chụp này.
                </div>
            </div>
        }
        else if (Model.TrangThai == 1 && Model.TrangThaiThanhToan == 0)
        {
            <div class="alert alert-warning d-flex align-items-center py-2 mb-3 border-0 shadow-sm">
                <i class="fas fa-hourglass-half me-2 text-dark"></i>
                <div class="small text-dark">
                    <strong>Đã duyệt:</strong> Đang đợi khách hàng thanh toán cọc qua Blockchain để chốt lịch.
                </div>
            </div>
        }
        else if (Model.TrangThai == 2 || Model.TrangThaiThanhToan == 1)
        {
            <div class="alert alert-success d-flex align-items-center py-2 mb-3 border-0 shadow-sm">
                <i class="fas fa-check-double me-2"></i>
                <div class="small">
                    <strong>Đã cọc:</strong> Tiền đã được khóa trong Smart Contract. Bạn có thể yên tâm đi chụp!
                </div>
            </div>
        }

        <div class="row align-items-center">
            <div class="col-md-4 border-end">
                <h6 class="text-muted small mb-1">Mã đơn: #@Model.MaDon</h6>
                <h5 class="fw-bold text-primary mb-2">
                    @(Model.MaGoiNavigation?.TenGoi ?? "📸 Yêu cầu riêng")
                </h5>
                <p class="mb-1 small"><i class="fas fa-clock me-2 text-secondary"></i>@Model.NgayChup.ToString("dd/MM/yyyy HH:mm")</p>
                <p class="mb-0 text-danger fw-bold"><i class="fas fa-tag me-2"></i>@Model.TongTien?.ToString("N0") đ</p>
            </div>

            <div class="col-md-4 border-end">
                <label class="text-muted small d-block mb-1">Thông tin khách hàng</label>
                <div class="d-flex align-items-center mb-2">
                    <img src="@(Model.MaKhachHangNavigation?.AnhDaiDien ?? "https://ui-avatars.com/api/?name=" + Model.MaKhachHangNavigation?.HoVaTen)"
                         class="rounded-circle me-2 border" width="45" height="45" style="object-fit: cover;">
                    <div>
                        <div class="fw-bold text-dark">@Model.MaKhachHangNavigation?.HoVaTen</div>
                        
                        @if (Model.TrangThai >= 2 || Model.TrangThaiThanhToan == 1)
                        {
                            <a href="tel:@Model.MaKhachHangNavigation?.SoDienThoai" class="text-decoration-none small fw-bold">
                                <i class="fas fa-phone me-1"></i> @Model.MaKhachHangNavigation?.SoDienThoai
                            </a>
                        }
                        else
                        {
                            <span class="text-muted small"><i class="fas fa-lock me-1"></i> SĐT ẩn (Chờ cọc)</span>
                        }
                    </div>
                </div>
                <div class="small text-muted"><i class="fas fa-map-marker-alt text-danger me-1"></i> @Model.DiaChiChup</div>
            </div>

            <div class="col-md-4 text-center">
                <div class="mb-3">
                    @if (Model.TrangThaiThanhToan == 1 || Model.TrangThai >= 2)
                    {
                        <span class="badge bg-success px-3 py-2 rounded-pill"><i class="fas fa-shield-alt me-1"></i> Blockchain đã giữ cọc</span>
                    }
                    else
                    {
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="fas fa-info-circle me-1"></i> Chưa nhận tiền</span>
                    }
                </div>

                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    @if (Model.TrangThai == 0) 
                    {
                        <form asp-controller="Photographer" asp-action="ApproveBooking" asp-route-id="@Model.MaDon" method="post" class="d-inline">
                            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold">CHẤP NHẬN</button>
                        </form>
                        <form asp-controller="Photographer" asp-action="RejectBooking" asp-route-id="@Model.MaDon" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">Từ chối</button>
                        </form>
                    }
                    else if (Model.TrangThai == 1 && Model.TrangThaiThanhToan == 0) 
                    {
                        <span class="badge bg-warning text-dark p-2 border border-warning rounded-pill animation-pulse w-100">
                            <i class="fas fa-spinner fa-spin me-1"></i> Đang chờ khách cọc
                        </span>
                    }
                    else if (Model.TrangThai == 2 || Model.TrangThaiThanhToan == 1) 
                    {
                        <span class="badge bg-info text-dark p-2 rounded-pill shadow-sm w-100">
                            <i class="fas fa-camera me-1"></i> Sẵn sàng chụp - Chờ nghiệm thu
                        </span>
                    }
                    else if (Model.TrangThai == 3) 
                    {
                        <div class="w-100">
                            <span class="text-success fw-bold d-block mb-2"><i class="fas fa-check-double me-1"></i> Giao dịch hoàn tất</span>
                            @* Nếu đã bàn giao, hiện nút cho thợ xem lại link *@
                            @if (!string.IsNullOrEmpty(Model.LinkSanPham))
                            {
                                <a href="@Model.LinkSanPham" target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                    <i class="fas fa-external-link-alt me-1"></i> Xem link đã gửi
                                </a>
                            }
                        </div>
                    }
                    else if (Model.TrangThai == 4) 
                    {
                        <span class="text-muted"><i class="fas fa-ban me-1"></i> Đã hủy</span>
                    }
                </div>
            </div>
        </div>

        @if (Model.TrangThai == 2 || (Model.TrangThai == 1 && Model.TrangThaiThanhToan == 1))
        {
            <div class="mt-4 p-3 border rounded-3 bg-light">
                <h6 class="fw-bold text-dark small mb-3"><i class="fas fa-upload me-2 text-primary"></i>BÀN GIAO SẢN PHẨM (LINK ẢNH)</h6>
                <form asp-action="DeliverProduct" asp-controller="Photographer" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maDon" value="@Model.MaDon" />
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-link text-muted"></i></span>
                        <input type="url" name="linkSanPham" class="form-control border-start-0" 
                               placeholder="Dán link Google Drive / Dropbox / OneDrive..." required>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                             GỬI KHÁCH HÀNG
                        </button>
                    </div>
                    <div class="form-text small text-muted mt-2">
                        <i class="fas fa-info-circle me-1"></i> <strong>Lưu ý:</strong> Sau khi gửi link, đơn hàng sẽ chuyển sang <strong>Hoàn thành</strong>. Khách hàng sẽ nhận được ảnh và bạn có thể nhận nốt thanh toán.
                    </div>
                </form>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.GhiChu))
        {
            <div class="bg-white p-2 mt-3 rounded-3 small border-start border-3 border-primary shadow-sm">
                <strong class="text-primary"><i class="fas fa-comment-alt me-1"></i> Ghi chú:</strong> @Model.GhiChu
            </div>
        }

        <div class="text-end mt-3 pt-2 border-top">
            <a href="/Chat?userId=@Model.MaKhachHang" class="text-decoration-none small fw-bold" title="Nhắn cho khách">
                <i class="fas fa-comments fa-lg text-primary me-1"></i> Nhắn tin trao đổi với khách
            </a>
        </div>
    </div>
</div>