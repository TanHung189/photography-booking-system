@model List<PhotoBooking.Models.DonDatLich>

@{
    ViewData["Title"] = "Quản lý lịch đặt";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="bg-light py-5" style="min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <h3 class="fw-bold mb-4 text-dark">Quản lý lịch đặt</h3>

                @{
                    var soDonCanCoc = Model.Count(d => d.TrangThai == 1 && d.TrangThaiThanhToan == 0);
                }

                @if (soDonCanCoc > 0)
                {
                    <div class="alert alert-warning border-warning shadow-sm mb-4 d-flex align-items-center bg-white" role="alert">
                        <i class="fas fa-exclamation-circle fa-2x text-danger me-3 animation-pulse"></i>
                        <div>
                            <h5 class="alert-heading fw-bold text-danger mb-1">Tin vui! Bạn có @soDonCanCoc lịch chụp đã được duyệt!</h5>
                            <p class="mb-0 text-dark">Vui lòng chuyển sang Tab <strong>"Chờ thanh toán cọc"</strong> bên dưới và tiến hành thanh toán cọc hoặc thanh toán để giữ chỗ nhé.</p>
                        </div>
                    </div>
                }

                <ul class="nav nav-pills nav-fill bg-white shadow-sm rounded-pill p-1 mb-4" id="bookingTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active rounded-pill fw-bold" data-bs-toggle="tab" data-bs-target="#tab-all">Tất cả</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link rounded-pill fw-bold" data-bs-toggle="tab" data-bs-target="#tab-pending">Chờ thợ duyệt</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link rounded-pill fw-bold position-relative" data-bs-toggle="tab" data-bs-target="#tab-payment">
                            Chờ thanh toán cọc
                            @if (soDonCanCoc > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light animation-pulse" style="font-size: 0.65rem;">
                                    @soDonCanCoc
                                </span>
                            }
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link rounded-pill fw-bold" data-bs-toggle="tab" data-bs-target="#tab-confirmed">Sắp tới</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link rounded-pill fw-bold" data-bs-toggle="tab" data-bs-target="#tab-finished">Hoàn thành</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link rounded-pill fw-bold" data-bs-toggle="tab" data-bs-target="#tab-cancelled">Đã hủy</button>
                    </li>
                </ul>

                <div class="tab-content">

                <div class="tab-pane fade show active" id="tab-all">
                    @await Html.PartialAsync("_BookingListPartial", Model)
                </div>

                <div class="tab-pane fade" id="tab-pending">
                    @await Html.PartialAsync("_BookingListPartial", Model.Where(x => x.TrangThai == 0).ToList())
                </div>

                <div class="tab-pane fade" id="tab-payment">
                    @await Html.PartialAsync("_BookingListPartial", Model.Where(x => x.TrangThai == 1 && x.TrangThaiThanhToan == 0).ToList())
                </div>

                <div class="tab-pane fade" id="tab-confirmed">
                    @await Html.PartialAsync("_BookingListPartial", Model.Where(x => x.TrangThai == 2 || (x.TrangThai == 1 && x.TrangThaiThanhToan == 1)).ToList())
                </div>

                <div class="tab-pane fade" id="tab-finished">
                    @await Html.PartialAsync("_BookingListPartial", Model.Where(x => x.TrangThai == 3).ToList())
                </div>

                <div class="tab-pane fade" id="tab-cancelled">
                    @await Html.PartialAsync("_BookingListPartial", Model.Where(x => x.TrangThai == 4).ToList())
                </div>

            </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateRating(maDon, soSao) {
            var inputElement = document.getElementById("rating-input-" + maDon);
            if (inputElement) {
                inputElement.value = soSao;
            }
            for (var i = 1; i <= 5; i++) {
                var star = document.getElementById("star-" + maDon + "-" + i);
                if (star) {
                    star.style.color = (i <= soSao) ? "#ffc107" : "#e4e5e9";
                }
            }
            var textElement = document.getElementById("rating-text-" + maDon);
            if (textElement) {
                var texts = ["Rất tệ", "Kém", "Bình thường", "Tốt", "Tuyệt vời"];
                textElement.innerText = texts[soSao - 1] + " (" + soSao + "/5)";
            }
        }
    </script>
}

<style>
    /* CSS Tùy chỉnh cho Tab */
    .nav-pills .nav-link {
        color: #555;
        transition: 0.3s;
    }

        .nav-pills .nav-link.active {
            background-color: #ff4757;
            color: white;
            box-shadow: 0 4px 10px rgba(255, 71, 87, 0.4);
        }

    /* CSS cho Card đơn hàng */
    .booking-card {
        transition: transform 0.2s ease;
        border: 1px solid #eee;
    }

        .booking-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        }

    .img-service {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: 10px;
    }

    .cursor-pointer {
        cursor: pointer;
        transition: 0.2s;
    }

        .cursor-pointer:hover {
            transform: scale(1.2);
        }

    .text-warning { color: #ffc107 !important; }
    .text-secondary { color: #e4e5e9 !important; }

    /* Hiệu ứng nhịp đập cho thông báo và nút */
    @@keyframes pulse-danger {
        0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); }
        70% { box-shadow: 0 0 0 6px rgba(220, 53, 69, 0); }
        100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
    }
    .animation-pulse {
        animation: pulse-danger 2s infinite;
    }
</style>