@model PhotoBooking.Models.GoiDichVu

@{
    ViewData["Title"] = Model.TenGoi;
    string imgSrc = !string.IsNullOrEmpty(Model.AnhDaiDien) ? Model.AnhDaiDien : $"https://source.unsplash.com/random/1200x800/?photography&sig={Model.MaGoi}";
}

<style>
    :root {
        --pb-primary: #ff4757;
        --pb-dark: #2f3542;
    }

    .breadcrumb-item a { color: var(--pb-primary); text-decoration: none; }
    
    /* Image Gallery Styling */
    .main-img-wrapper {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .main-img {
        width: 100%;
        height: 500px;
        object-fit: cover;
        transition: transform 0.5s ease;
    }
    .main-img-wrapper:hover .main-img { transform: scale(1.05); }

    /* Info Badge */
    .category-badge {
        background: rgba(255, 71, 87, 0.1);
        color: var(--pb-primary);
        padding: 6px 16px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    /* Sticky Booking Card */
    .sticky-booking-card {
        position: sticky;
        top: 100px;
        border: 1px solid #eee;
        border-radius: 24px;
        padding: 24px;
        background: #fff;
        box-shadow: 0 15px 45px rgba(0,0,0,0.08);
    }

    /* Icon Box Section */
    .feature-icon-box {
        background: #f8f9fa;
        border-radius: 16px;
        padding: 15px;
        height: 100%;
        transition: all 0.3s ease;
        border: 1px solid transparent;
    }
    .feature-icon-box:hover {
        background: #fff;
        border-color: var(--pb-primary);
        transform: translateY(-5px);
    }

    /* Delivery Section */
    .delivery-card {
        background: var(--pb-dark);
        color: #fff;
        border-radius: 20px;
        padding: 30px;
    }
    .delivery-item {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
        padding: 8px;
        border-radius: 10px;
        transition: background 0.3s;
    }
    .delivery-item:hover { background: rgba(255,255,255,0.05); }

    .btn-book-now {
        background: linear-gradient(45deg, #ff4757, #ff6b81);
        border: none;
        padding: 15px;
        font-size: 1.1rem;
        transition: all 0.3s;
    }
    .btn-book-now:hover {
        transform: scale(1.02);
        box-shadow: 0 5px 15px rgba(255, 71, 87, 0.4);
    }
</style>

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><span class="text-muted">@Model.MaDanhMucNavigation?.TenDanhMuc</span></li>
            <li class="breadcrumb-item active">Chi tiết</li>
        </ol>
    </nav>

    <div class="row g-5">
        <div class="col-lg-8">
            <div class="main-img-wrapper mb-4">
                <img src="@imgSrc" class="main-img" alt="@Model.TenGoi">
                <div class="position-absolute top-0 end-0 p-3">
                    <button class="btn btn-light rounded-circle shadow-sm"><i class="fa-regular fa-heart"></i></button>
                </div>
            </div>

            <div class="mb-5">
                <span class="category-badge mb-2 d-inline-block">@Model.MaDanhMucNavigation?.TenDanhMuc</span>
                <h1 class="display-5 fw-bold text-dark mb-4">@Model.TenGoi</h1>
                
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="feature-icon-box">
                            <i class="fa-regular fa-clock fs-4 text-primary mb-2"></i>
                            <h6 class="fw-bold mb-1">@Model.ThoiLuong phút</h6>
                            <p class="small text-muted mb-0">Thời gian thực hiện</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-icon-box">
                            <i class="fa-solid fa-user-group fs-4 text-success mb-2"></i>
                            <h6 class="fw-bold mb-1">Tối đa @Model.SoNguoiToiDa người</h6>
                            <p class="small text-muted mb-0">Quy mô nhóm</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-icon-box">
                            <i class="fa-solid fa-camera-retro fs-4 text-warning mb-2"></i>
                            <h6 class="fw-bold mb-1">Chuyên nghiệp</h6>
                            <p class="small text-muted mb-0">Thiết bị & Phông nền</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-5">
                <h4 class="fw-bold border-start border-4 border-primary ps-3 mb-4">Mô tả gói chụp</h4>
                <div class="lh-lg text-secondary" style="text-align: justify; font-size: 1.05rem;">
                    @Html.Raw(Model.MoTaChiTiet?.Replace("\n", "<br>"))
                </div>
            </div>

            <div class="delivery-card mb-5">
                <h4 class="fw-bold mb-4 text-white"><i class="fa-solid fa-box-open me-2 text-warning"></i>Sản phẩm bạn nhận được</h4>
                <div class="row">
                    @{
                        var products = Model.SanPhamBanGiao?.Split(',') ?? Array.Empty<string>();
                    }
                    @foreach (var p in products)
                    {
                        <div class="col-md-6">
                            <div class="delivery-item">
                                <i class="fa-solid fa-circle-check text-warning me-3"></i>
                                <span>@p.Trim()</span>
                            </div>
                        </div>
                    }
                </div>
                <div class="mt-4 p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10">
                    <small class="opacity-75 italic"><i class="fa-solid fa-info-circle me-2"></i>Ảnh gốc sẽ được gửi ngay sau buổi chụp, ảnh chỉnh sửa bàn giao sau 3-5 ngày qua Cloud.</small>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="sticky-booking-card">
                <div class="d-flex justify-content-between align-items-end mb-4">
                    <div>
                        <span class="text-muted small">Giá trọn gói</span>
                        <h2 class="text-danger fw-black mb-0">@Model.GiaTien.ToString("N0") đ</h2>
                    </div>
                    @if (Model.GiaCoc > 0)
                    {
                        <div class="text-end">
                            <span class="badge bg-warning text-dark">Cọc @Model.GiaCoc?.ToString("N0") đ</span>
                        </div>
                    }
                </div>

                <div class="mb-4 p-3 rounded-3 bg-light border">
                    <div class="d-flex align-items-center">
                        <img src="https://ui-avatars.com/api/?name=@Model.MaNhiepAnhGiaNavigation?.HoVaTen&background=random" class="rounded-circle me-3" width="50" height="50">
                        <div>
                            <h6 class="mb-0 fw-bold">@Model.MaNhiepAnhGiaNavigation?.HoVaTen</h6>
                            <small class="text-muted"><i class="fa-solid fa-star text-warning me-1"></i> 4.9 (120 đánh giá)</small>
                        </div>
                    </div>
                    <hr class="my-2">
                    <a asp-controller="Photographer" asp-action="Profile" asp-route-id="@Model.MaNhiepAnhGia" class="btn btn-sm btn-outline-dark w-100 rounded-pill mt-1">Xem hồ sơ nhiếp ảnh gia</a>
                </div>

                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Booking" asp-action="Create" asp-route-packageId="@Model.MaGoi" class="btn btn-danger btn-book-now w-100 rounded-pill fw-bold mb-3 shadow">
                        <i class="fa-regular fa-calendar-check me-2"></i> ĐẶT LỊCH NGAY
                    </a>
                    <p class="text-center text-muted small mb-0">Hỗ trợ thanh toán bảo mật qua <br><strong>Blockchain Smart Contract</strong></p>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-dark w-100 rounded-pill py-3 fw-bold mb-3">
                        <i class="fa-solid fa-lock me-2"></i> ĐĂNG NHẬP ĐỂ ĐẶT
                    </a>
                }
                
                <div class="mt-4 border-top pt-3">
                    <div class="d-flex align-items-center text-muted small mb-2">
                        <i class="fa-solid fa-shield-check me-2 text-success"></i>
                        <span>Cam kết không phát sinh chi phí</span>
                    </div>
                    <div class="d-flex align-items-center text-muted small">
                        <i class="fa-solid fa-rotate me-2 text-primary"></i>
                        <span>Hoàn cọc nếu hủy trước 24h</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>