@model List<PhotoBooking.Models.DonDatLich>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

@if (Model == null || Model.Count == 0)
{
    <div class="text-center py-5">
        <img src="https://cdni.iconscout.com/illustration/premium/thumb/empty-state-2130362-1800926.png" width="150" alt="Empty" />
        <p class="text-muted mt-3">Không có đơn đặt lịch nào ở mục này.</p>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <div class="card booking-card shadow-sm border-0 mb-4 rounded-4 overflow-hidden @(item.TrangThai == 4 ? "opacity-75" : "") @(item.TrangThai == 1 && item.TrangThaiThanhToan == 0 ? "border-start border-warning border-5" : "")">
            <div class="card-body p-0">
                
                @if (item.TrangThai == 1 && item.TrangThaiThanhToan == 0)
                {
                    <div class="bg-danger-subtle p-2 px-3 d-flex align-items-center border-bottom border-danger border-opacity-25">
                        <i class="fas fa-bullhorn text-danger me-2 heartbeat-animation"></i>
                        <span class="small fw-bold text-danger">
                            Nhiếp ảnh gia @(item.MaNhiepAnhGiaNavigation?.HoVaTen) đã đồng ý! Hãy đặt cọc ngay để giữ chỗ.
                        </span>
                    </div>
                }
                else if (item.TrangThai == 0)
                {
                    <div class="bg-light p-2 px-3 d-flex align-items-center border-bottom">
                        <i class="fas fa-clock text-muted me-2"></i>
                        <span class="small text-muted">
                            Đang đợi @(item.MaNhiepAnhGiaNavigation?.HoVaTen) kiểm tra lịch và phản hồi...
                        </span>
                    </div>
                }
                else if (item.TrangThai == 2)
                {
                    <div class="bg-success-subtle p-2 px-3 d-flex align-items-center border-bottom border-success border-opacity-25">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <span class="small fw-bold text-success">
                            Lịch chụp đã chốt! Nhiếp ảnh gia sẽ liên hệ bạn trước ngày chụp.
                        </span>
                    </div>
                }
                else if (item.TrangThai == 4)
                {
                    <div class="p-2 px-3 d-flex align-items-center border-bottom" style="background-color: #e9ecef; border-color: #dee2e6 !important;">
                        <i class="fas fa-ban me-2" style="color: #495057;"></i>
                        <span class="small fw-bold text-decoration-line-through" style="color: #495057;">
                            Yêu cầu này đã bị hủy hoặc Nhiếp ảnh gia @(item.MaNhiepAnhGiaNavigation?.HoVaTen) đã từ chối lịch chụp.
                        </span>
                    </div>
                }

                <div class="d-flex flex-column flex-md-row p-3">
                    <div class="me-md-3 mb-3 mb-md-0">
                        <img src="@(item.MaGoiNavigation?.AnhDaiDien ?? item.MaNhiepAnhGiaNavigation?.AnhDaiDien ?? "https://ui-avatars.com/api/?name=Service&background=random")"
                             class="img-service shadow-sm rounded-3"
                             style="width: 150px; height: 120px; object-fit: cover;"
                             alt="Service Image">
                    </div>

                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                @if (item.TrangThai == 4) 
                                {
                                    <span class="badge bg-secondary mb-2"><i class="fas fa-ban me-1"></i> Đã hủy</span>
                                }
                                else if (item.TrangThai == 0) 
                                {
                                    <span class="badge bg-info text-dark mb-2"><i class="fas fa-hourglass-start me-1"></i> Chờ xác nhận</span>
                                }
                                else if (item.TrangThai == 1 && item.TrangThaiThanhToan == 0) 
                                {
                                    <span class="badge bg-danger mb-2 animation-pulse"><i class="fas fa-exclamation-triangle me-1"></i> Yêu cầu đặt cọc</span>
                                }
                                else if (item.TrangThai == 2 || item.TrangThaiThanhToan == 1) 
                                {
                                    <span class="badge bg-primary mb-2"><i class="fas fa-calendar-check me-1"></i> Sắp tới (Đã cọc)</span>
                                }
                                else if (item.TrangThai == 3) 
                                {
                                    <span class="badge bg-success mb-2"><i class="fas fa-check-circle me-1"></i> Hoàn thành</span>
                                }

                                <h5 class="fw-bold mb-1">@(item.MaGoiNavigation?.TenGoi ?? "📸 Chụp ảnh theo yêu cầu riêng")</h5>
                                <p class="text-muted small mb-1">
                                    <i class="fa-solid fa-camera me-1"></i>
                                    @(item.MaNhiepAnhGiaNavigation?.HoVaTen ?? "Đang cập nhật")
                                </p>

                                <p class="text-muted small mb-0">
                                    <i class="fa-regular fa-calendar-days me-1"></i>
                                    @item.NgayChup.ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>
                            <div class="text-end">
                                <div class="fs-5 fw-bold text-danger">@item.TongTien?.ToString("N0") đ</div>
                                <div class="small text-muted">Cọc 30%: @((item.TongTien * 0.3m)?.ToString("N0")) đ</div>
                            </div>
                        </div>

                        <hr class="my-3 text-muted opacity-25">

                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">Mã đơn: <span class="fw-bold text-dark">#@item.MaDon</span></small>
                            <div class="d-flex gap-2">

                                <a href="/Chat?userId=@item.MaNhiepAnhGia" class="btn btn-sm btn-light text-primary border rounded-pill px-3">
                                    <i class="fas fa-comment"></i> Chat
                                </a>

                                <a asp-controller="Booking" asp-action="Payment" asp-route-id="@item.MaDon"
                                   class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                    Chi tiết đơn
                                </a>

                                @if (item.TrangThai == 1 && item.TrangThaiThanhToan == 0)
                                {
                                    <a asp-controller="Booking" asp-action="Payment" asp-route-id="@item.MaDon"
                                       class="btn btn-warning btn-sm rounded-pill px-4 fw-bold shadow-sm animation-pulse">
                                        <i class="fab fa-ethereum me-1"></i> ĐẶT CỌC NGAY
                                    </a>
                                }

                                @if (item.TrangThai == 3)
                                {
                                    @if (item.DanhGium == null)
                                    {
                                        <button class="btn btn-warning btn-sm rounded-pill px-3 fw-bold"
                                                data-bs-toggle="modal" data-bs-target="#reviewModal-@item.MaDon">
                                            <i class="fa-regular fa-star me-1"></i> Đánh giá ngay
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary btn-sm rounded-pill px-3" disabled>
                                            <i class="fas fa-check me-1"></i> Đã đánh giá
                                        </button>
                                    }
                                }

                                @if (item.TrangThai == 3 && !string.IsNullOrEmpty(item.LinkSanPham))
                                {
                                    <div class="mt-3 p-3 border rounded-4 bg-success bg-opacity-10">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h6 class="fw-bold text-success mb-1"><i class="fas fa-gift me-2"></i>BỘ ẢNH ĐÃ SẴN SÀNG!</h6>
                                                <small class="text-muted">Bàn giao ngày: @item.NgayBanGiao?.ToString("dd/MM/yyyy HH:mm")</small>
                                            </div>
                                            <a href="@item.LinkSanPham" target="_blank" class="btn btn-success rounded-pill fw-bold shadow-sm px-4">
                                                <i class="fas fa-download me-2"></i> TẢI NGAY
                                            </a>
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="reviewModal-@item.MaDon" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-warning text-dark border-0">
                        <h5 class="modal-title fw-bold">Đánh giá dịch vụ #@item.MaDon</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <form asp-controller="Review" asp-action="SubmitReview" method="post">
                        <div class="modal-body text-center p-4">
                            <input type="hidden" name="MaDon" value="@item.MaDon" />
                            <input type="hidden" name="SoSao" id="rating-input-@item.MaDon" value="5" />
                            <p class="mb-3 fw-bold text-secondary">Bạn cảm thấy dịch vụ thế nào?</p>
                            <div class="mb-3 d-flex justify-content-center gap-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fa-solid fa-star fa-2x cursor-pointer star-icon-js"
                                       id="star-@item.MaDon-@i"
                                       style="color: @(i <= 5 ? "#ffc107" : "#e4e5e9"); transition: 0.2s;"
                                       onclick="updateRating(@item.MaDon, @i)"></i>
                                }
                            </div>
                            <div class="fw-bold text-warning mb-3" id="rating-text-@item.MaDon">Tuyệt vời (5/5)</div>
                            <textarea name="BinhLuan" class="form-control bg-light" rows="3" placeholder="Chia sẻ cảm nhận của bạn về thợ chụp..."></textarea>
                        </div>
                        <div class="modal-footer border-0 pt-0 pb-4 justify-content-center">
                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                            <button type="submit" class="btn btn-dark rounded-pill px-5 fw-bold shadow">Gửi đánh giá</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        
    }
}

<script>
    function updateRating(maDon, soSao) {
        const inputField = document.getElementById(`rating-input-${maDon}`);
        if(inputField) inputField.value = soSao;
        for (let i = 1; i <= 5; i++) {
            let star = document.getElementById(`star-${maDon}-${i}`);
            if (star) {
                star.style.color = (i <= soSao) ? "#ffc107" : "#e4e5e9";
            }
        }
        const textLabel = document.getElementById(`rating-text-${maDon}`);
        const textMap = ["Tệ", "Không tốt", "Bình thường", "Tốt", "Tuyệt vời"];
        if(textLabel) textLabel.innerText = `${textMap[soSao-1]} (${soSao}/5)`;
    }
</script>

