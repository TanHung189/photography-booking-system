@{
    ViewData["Title"] = "Tin nhắn";
    var listUsers = ViewBag.ListUsers as List<PhotoBooking.Models.NguoiDung>;
    int myId = ViewBag.CurrentUserId != null ? (int)ViewBag.CurrentUserId : 0;
}

<div class="container py-4" style="height: 85vh;">
    <div class="row h-100 shadow rounded-3 overflow-hidden border">

        <div class="col-md-4 bg-light border-end h-100 d-flex flex-column p-0">
            <div class="p-3 bg-white border-bottom">
                <h5 class="fw-bold mb-0 text-primary"><i class="fas fa-comments me-2"></i>Hộp thư đến</h5>
            </div>

            <div class="overflow-auto flex-grow-1" id="userList">
                @if (listUsers != null && listUsers.Any())
                {
                    foreach (var user in listUsers)
                    {
                        <div id="user-item-@user.MaNguoiDung"
                             class="d-flex align-items-center p-3 border-bottom user-item"
                             onclick="loadChat(@user.MaNguoiDung)"
                             style="cursor: pointer; transition: 0.2s;">

                            <img src="@(user.AnhDaiDien ?? $"https://ui-avatars.com/api/?name={user.HoVaTen}&background=random")"
                                 class="rounded-circle me-3 border" width="50" height="50" style="object-fit:cover">

                            <div class="w-100">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-bold text-dark">@user.HoVaTen</span>
                                </div>
                                <small class="text-muted status-text">Chạm để trò chuyện</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <small>Chưa có tin nhắn nào.</small>
                    </div>
                }
            </div>
        </div>

        <div class="col-md-8 bg-white h-100 d-flex flex-column p-0 position-relative">

            <div id="chatHeader" class="p-3 border-bottom bg-white d-flex align-items-center shadow-sm d-none" style="z-index: 10;">
                <img id="headerAvatar" src="" class="rounded-circle me-3 border" width="45" height="45" style="object-fit:cover">
                <div>
                    <h6 id="headerName" class="mb-0 fw-bold">...</h6>
                    <small class="text-success"><i class="fas fa-circle" style="font-size: 8px;"></i> Đang hoạt động</small>
                </div>
            </div>

            <div class="flex-grow-1 p-4 overflow-auto" id="messagesList" style="background-color: #f0f2f5;">
                <div id="welcomeScreen" class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                    <i class="far fa-paper-plane fa-5x mb-3 text-secondary opacity-50"></i>
                    <h4>PhotoChat</h4>
                    <p>Chọn một cuộc hội thoại để bắt đầu.</p>
                </div>
            </div>

            <div id="inputArea" class="p-3 border-top bg-white d-none">
                <div class="input-group">
                    <input type="text" id="messageInput" class="form-control border-0 bg-light rounded-pill px-4 py-2"
                           placeholder="Nhập tin nhắn..." autocomplete="off">
                    <button class="btn btn-primary rounded-circle ms-2 d-flex align-items-center justify-content-center"
                            id="sendButton" style="width: 45px; height: 45px;">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>

<script>
    // --- KHỞI TẠO BIẾN TOÀN CỤC ---
    const connection = new signalR.HubConnectionBuilder().withUrl("/chathub").build();
    const myId = @myId;
    let currentReceiverId = 0; // Quan trọng: Biến này xác định đang chat với ai

    // --- 1. HÀM LOAD CHAT KHI BẤM VÀO USER ---
    async function loadChat(userId) {
        // Cập nhật người nhận hiện tại
        currentReceiverId = userId;

        // UI: Active màu xanh cho user đang chọn
        document.querySelectorAll('.user-item').forEach(el => el.classList.remove('bg-light', 'border-start', 'border-4', 'border-primary'));
        const activeItem = document.getElementById(`user-item-${userId}`);
        if(activeItem) activeItem.classList.add('bg-light', 'border-start', 'border-4', 'border-primary');

        // UI: Ẩn màn hình chờ, hiện khung chat
        document.getElementById('welcomeScreen').classList.add('d-none');
        document.getElementById('chatHeader').classList.remove('d-none');
        document.getElementById('inputArea').classList.remove('d-none');

        // UI: Hiện Loading xoay vòng
        const msgList = document.getElementById("messagesList");
        msgList.innerHTML = '<div class="text-center mt-5"><div class="spinner-border text-primary" role="status"></div></div>';

        try {
            // Gọi API lấy dữ liệu
            const response = await fetch(`/Chat/GetConversation?otherUserId=${userId}`);
            const data = await response.json();

            // Cập nhật Header (Ảnh + Tên)
            document.getElementById('headerName').innerText = data.otherUser.hoVaTen;
            const avatarUrl = data.otherUser.anhDaiDien ?? `https://ui-avatars.com/api/?name=${data.otherUser.hoVaTen}&background=random`;
            document.getElementById('headerAvatar').src = avatarUrl;

            // Xóa Loading, Render tin nhắn
            msgList.innerHTML = '';

            if (data.messages.length === 0) {
                msgList.innerHTML = '<div class="text-center text-muted mt-5"><small>Hai bạn chưa có tin nhắn nào. Hãy gửi lời chào!</small></div>';
            } else {
                data.messages.forEach(msg => {
                    renderMessage(msg.nguoiGuiId, msg.noiDung, msg.thoiGianGui, msg.maTinNhan, msg.isDeleted);
                });
            }
            scrollToBottom();

        } catch (error) {
            console.error("Lỗi tải chat:", error);
            msgList.innerHTML = '<div class="text-center text-danger mt-5">Không thể tải tin nhắn.</div>';
        }
    }

    // --- 2. HÀM VẼ TIN NHẮN (HTML GENERATOR) ---
    function renderMessage(senderId, content, time, msgId, isDeleted) {
        const isMe = (senderId == myId);

        // Cấu hình giao diện
        const alignClass = isMe ? "justify-content-end" : "justify-content-start";
        const bgColor = isMe ? "#0084ff" : "#ffffff";
        const textColor = isMe ? "#ffffff" : "#000000";
        const radius = isMe ? "border-bottom-right-radius: 2px" : "border-bottom-left-radius: 2px";

        // Xử lý nội dung (nếu bị xóa)
        let msgContent = isDeleted
            ? `<em class="opacity-50"><i class="fas fa-ban me-1"></i> Tin nhắn đã thu hồi</em>`
            : content;

        // Xử lý màu sắc (nếu bị xóa)
        const finalBg = isDeleted ? "#f2f2f2" : bgColor;
        const finalText = isDeleted ? "#999" : textColor;

        // Nút thu hồi (Chỉ hiện cho tin của mình và chưa xóa)
        const deleteBtn = (isMe && !isDeleted)
            ? `<i class="fas fa-ellipsis-v ms-2 text-muted unsend-btn" onclick="unsendMessage(${msgId})" title="Thu hồi" style="cursor:pointer; font-size:12px; margin-top:10px;"></i>`
            : ``;

        const html = `
            <div class="d-flex mb-3 ${alignClass}" id="msg-${msgId}">
                <div class="d-flex align-items-start ${isMe ? 'flex-row-reverse' : ''}">

                    <div class="p-3 rounded-3 shadow-sm msg-box"
                         style="max-width: 400px; background-color: ${finalBg}; color: ${finalText}; ${radius}; transition: all 0.3s;">
                        <p class="mb-1 text-break msg-content">${msgContent}</p>
                        <small class="${isMe && !isDeleted ? "text-white-50" : "text-muted"}" style="font-size: 0.7rem; float: right; margin-top: 4px;">
                            ${time}
                        </small>
                    </div>

                    ${deleteBtn}
                </div>
            </div>
        `;

        document.getElementById("messagesList").insertAdjacentHTML('beforeend', html);
    }

    // --- 3. XỬ LÝ SIGNALR (REAL-TIME) ---
    connection.on("ReceiveMessage", function (senderId, message, time) {
        // Chỉ hiện tin nhắn nếu:
        // 1. Người gửi là người mình đang chat (senderId == currentReceiverId)
        // 2. Hoặc người gửi là chính mình (để hiện tin mình vừa gửi ở tab khác)
        // Lưu ý: senderId từ Server trả về là string, cần so sánh lỏng (==) hoặc ép kiểu
        if (senderId == currentReceiverId || senderId == myId) {
            // Giả lập msgId = 0 vì real-time chưa cần id để xóa ngay (cần F5 để có ID xóa)
            renderMessage(parseInt(senderId), message, time, 0, false);
            scrollToBottom();
        }
    });

    // Xử lý sự kiện thu hồi Realtime
    connection.on("MessageUnsent", function (msgId) {
        const msgDiv = document.getElementById(`msg-${msgId}`);
        if (msgDiv) {
            const box = msgDiv.querySelector('.msg-box');
            const content = msgDiv.querySelector('.msg-content');
            const btn = msgDiv.querySelector('.unsend-btn');

            // Cập nhật giao diện thành "Đã thu hồi"
            box.style.backgroundColor = "#f2f2f2";
            box.style.color = "#999";
            content.innerHTML = '<em class="opacity-50"><i class="fas fa-ban me-1"></i> Tin nhắn đã thu hồi</em>';
            if(btn) btn.remove();
        }
    });

    connection.start().catch(err => console.error(err));

    // --- 4. HÀM HỖ TRỢ ---

    // Gửi tin nhắn
    document.getElementById("sendButton").addEventListener("click", function (event) {
        const input = document.getElementById("messageInput");
        const msg = input.value;
        if (msg.trim() !== "" && currentReceiverId !== 0) {
            connection.invoke("SendMessage", currentReceiverId.toString(), msg).catch(err => console.error(err));
            input.value = "";
            input.focus();
        }
    });

    // Enter để gửi
    document.getElementById("messageInput").addEventListener("keypress", function(event) {
        if (event.key === "Enter") document.getElementById("sendButton").click();
    });

    // Thu hồi tin nhắn
    function unsendMessage(msgId) {
        if(confirm("Bạn muốn thu hồi tin nhắn này với mọi người?")) {
            connection.invoke("UnsendMessage", msgId).catch(err => console.error(err));
        }
    }

    function scrollToBottom() {
        const list = document.getElementById("messagesList");
        list.scrollTop = list.scrollHeight;
    }

       // --- 5. TỰ ĐỘNG LOAD KHI VÀO TRANG ---
    window.onload = function() {
        const urlParams = new URLSearchParams(window.location.search);
        const targetUserId = urlParams.get('userId');

        if (targetUserId) {
            // 1. Load nội dung chat
            loadChat(targetUserId);

            // 2. Cuộn cột trái đến đúng vị trí user đó (nếu danh sách dài)
            const userElement = document.getElementById(`user-item-${targetUserId}`);
            if (userElement) {
                userElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }
    };
</script>

<style>
    .user-item:hover {
        background-color: #f8f9fa;
    }
    /* Thanh cuộn đẹp */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-thumb { background: #ccc; border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: #bbb; }
</style>