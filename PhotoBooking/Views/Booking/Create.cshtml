@model PhotoBooking.ViewModels.BookingViewModel

@{
    ViewData["Title"] = "Đặt lịch chụp";
}

<div class="container py-5">
    <div class="row g-5">

        <div class="col-md-5 col-lg-4 order-md-last">
            <h4 class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-primary fw-bold">Gói dịch vụ</span>
            </h4>
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <img src="@Model.AnhBia" class="card-img-top" alt="@Model.TenGoi" style="height: 200px; object-fit: cover;">
                <div class="card-body bg-light">
                    <h5 class="card-title fw-bold">@Model.TenGoi</h5>
                    <p class="text-muted small mb-2"><i class="fas fa-camera me-1"></i> @Model.TenNhiepAnhGia</p>
                    <hr>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Giá trọn gói:</span>
                        <strong class="text-dark">@Model.GiaTien.ToString("#,##0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between text-danger">
                        <span>Cần đặt cọc:</span>
                        <strong>@Model.GiaCoc.ToString("#,##0") đ</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-7 col-lg-8">
            <h4 class="mb-3 fw-bold">Thông tin đặt lịch</h4>
            <form asp-action="Create" method="post" class="needs-validation">
                <input type="hidden" asp-for="MaGoi" />
                <input type="hidden" asp-for="TenGoi" />
                <input type="hidden" asp-for="GiaTien" />
                <input type="hidden" asp-for="GiaCoc" />

                <div class="row g-3">

                    <div class="col-12">
                        <label class="form-label fw-bold">Ngày & Giờ chụp mong muốn</label>
                        <input asp-for="NgayChup" class="form-control py-3" type="datetime-local" />
                        <span asp-validation-for="NgayChup" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Địa điểm chụp</label>
                        <input asp-for="DiaChiChup" class="form-control py-3" placeholder="Ví dụ: Công viên Cầu Giấy, Hà Nội..." />
                        <span asp-validation-for="DiaChiChup" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Ghi chú cho nhiếp ảnh gia</label>
                        <textarea asp-for="GhiChu" class="form-control" rows="4" placeholder="Bạn có yêu cầu đặc biệt gì về trang phục hay concept không?"></textarea>
                    </div>

                    <hr class="my-4">

                    <button class="w-100 btn btn-primary btn-lg rounded-pill fw-bold" type="submit">
                        XÁC NHẬN ĐẶT LỊCH
                    </button>
                    <p class="text-center mt-3 text-muted small">Bạn sẽ được chuyển đến trang thanh toán cọc sau bước này.</p>
                </div>
            </form>
        </div>
    </div>
</div>