@model PhotoBooking.Models.DonDatLich
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Thanh toán đơn hàng #" + Model.MaDon;

    // --- CẤU HÌNH TÀI KHOẢN NHẬN TIỀN (Web2) ---
    var nganHang = "Vietcombank";
    var soTaiKhoan = "9399308546";
    var tenChuThe = "BUI DO TAN HUNG";

    // Logic tính tiền cọc
    decimal tienCanThanhToan = (Model.TienDaCoc > 0) ? (decimal)Model.TienDaCoc : (decimal)Model.TongTien * 0.3m;
    var noiDungCK = "TAHU" + Model.MaDon;
    var qrLink = $"https://img.vietqr.io/image/{nganHang}-{soTaiKhoan}-compact2.png?amount={tienCanThanhToan}&addInfo={noiDungCK}&accountName={tenChuThe}";

    // --- CẤU HÌNH BLOCKCHAIN (Web3) ---
    // Giả lập tỷ giá: 1 ETH = 80,000,000 VNĐ (Thực tế bạn có thể gọi API tỷ giá)
    // Để test môn học, ta fix cứng một lượng ETH nhỏ (VD: 0.001 ETH)
    string ethAmountToPay = "0.001";
}

<div class="container py-5">
    <div class="row g-5">

        <div class="col-lg-7">
            <h4 class="fw-bold mb-4">📝 Thông tin đơn đặt lịch</h4>
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-3">
                        <span class="text-muted">Mã đơn hàng:</span>
                        <span class="fw-bold text-primary">#@Model.MaDon</span>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small">Dịch vụ / Yêu cầu</label>
                        <h5 class="fw-bold">
                            @(Model.MaGoiNavigation?.TenGoi ?? "Chụp ảnh theo yêu cầu riêng")
                        </h5>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="text-muted small">Nhiếp ảnh gia</label>
                            <div class="fw-bold">@Model.MaNhiepAnhGiaNavigation?.HoVaTen</div>
                        </div>
                        <div class="col-6 text-end">
                            <label class="text-muted small">Ngày chụp</label>
                            <div class="fw-bold">@Model.NgayChup.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="text-muted small">Địa điểm</label>
                        <div class="fw-bold"><i class="fas fa-map-marker-alt text-danger me-1"></i> @Model.DiaChiChup</div>
                    </div>
                    <div class="bg-light p-3 rounded">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tổng giá trị hợp đồng:</span>
                            <span class="fw-bold">@Model.TongTien?.ToString("N0") đ</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark">SỐ TIỀN CẦN CỌC (30%):</span>
                            <span class="fs-4 fw-bold text-danger">@tienCanThanhToan.ToString("N0") đ</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-warning shadow text-center">
                <div class="card-header bg-warning text-dark fw-bold">
                    <i class="fas fa-wallet me-2"></i>CHỌN PHƯƠNG THỨC THANH TOÁN
                </div>
                <div class="card-body p-4">

                    <h6 class="fw-bold text-primary mb-3">Tùy chọn 1: Thanh toán an toàn qua Blockchain</h6>
                    <p class="text-muted small mb-3">
                        Tiền cọc của bạn sẽ được giữ bởi Hợp đồng thông minh (Escrow).
                    </p>
                    <button type="button" id="btnPayCrypto" class="btn btn-dark w-100 py-3 fw-bold shadow-sm mb-4">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/3/36/MetaMask_Fox.svg" width="25" class="me-2" />
                        ĐẶT CỌC BẰNG METAMASK (@ethAmountToPay ETH)
                    </button>

                    <hr class="text-muted">

                    <h6 class="fw-bold text-secondary mb-3 mt-4">Tùy chọn 2: Chuyển khoản ngân hàng truyền thống</h6>
                    <img src="@qrLink" class="img-fluid mb-3 border rounded p-2" style="max-width: 200px;" alt="QR Code">
                    <div class="alert alert-info small text-start mb-3">
                        <strong><i class="fas fa-info-circle"></i> Lưu ý:</strong><br>
                        Nội dung chuyển khoản bắt buộc: <strong class="text-danger">@noiDungCK</strong>
                    </div>

                    <form asp-action="ConfirmPayment" method="post">
                        <input type="hidden" name="id" value="@Model.MaDon" />
                        <button type="submit" class="btn btn-outline-success w-100 py-2 fw-bold"
                                onclick="return confirm('Bạn chắc chắn đã chuyển khoản ngân hàng thành công?')">
                            <i class="fas fa-check-circle me-2"></i>TÔI ĐÃ CHUYỂN KHOẢN NGÂN HÀNG
                        </button>
                    </form>

                    <div class="mt-4">
                        <a href="/" class="text-decoration-none text-muted small">Thanh toán sau (Về trang chủ)</a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/5.7.2/ethers.umd.min.js"></script>
<script>
    document.getElementById('btnPayCrypto').addEventListener('click', async () => {
        // 1. Kiểm tra ví MetaMask
        if (typeof window.ethereum === 'undefined') {
            alert('Bạn chưa cài đặt ví MetaMask trên trình duyệt!');
            return;
        }

        try {
            // Thay đổi nút để báo hiệu đang xử lý
            const btn = document.getElementById('btnPayCrypto');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang chờ xác nhận...';
            btn.disabled = true;

            // 2. Kết nối ví
            await window.ethereum.request({ method: 'eth_requestAccounts' });
            const provider = new ethers.providers.Web3Provider(window.ethereum);
            const signer = provider.getSigner();

            // 3. Thông tin Hợp đồng thông minh (Smart Contract)
            // LƯU Ý: CHÚNG TA SẼ ĐIỀN ĐỊA CHỈ HỢP ĐỒNG TỪ REMIX VÀO ĐÂY SAU
            const contractAddress = "@Configuration["BlockchainConfig:PhotoEscrowAddress"]"
            const contractABI = [
                "function deposit() public payable"
            ];
            const contract = new ethers.Contract(contractAddress, contractABI, signer);

            // 4. Gửi giao dịch
            const ethAmount = "@ethAmountToPay";
            const tx = await contract.deposit({ value: ethers.utils.parseEther(ethAmount) });

            alert('Đang ghi nhận lên mạng lưới Blockchain... Vui lòng không đóng trang!');

            // 5. Đợi giao dịch hoàn tất và lấy mã TxHash
            const receipt = await tx.wait();

            alert('🎉 Chúc mừng! Đặt cọc qua Blockchain thành công.\nMã giao dịch: ' + receipt.transactionHash);

                let payButton = document.getElementById("btn-pay-crypto"); // Thay "btn-pay-crypto" bằng đúng ID cái nút của bạn

           

        } catch (error) {
            console.error(error);
            alert('Giao dịch thất bại hoặc đã bị bạn hủy bỏ!');

            // Phục hồi lại nút bấm
            const btn = document.getElementById('btnPayCrypto');
            btn.innerHTML = '<img src="https://upload.wikimedia.org/wikipedia/commons/3/36/MetaMask_Fox.svg" width="25" class="me-2" /> ĐẶT CỌC BẰNG METAMASK (@ethAmountToPay ETH)';
            btn.disabled = false;
        }
    });
</script>